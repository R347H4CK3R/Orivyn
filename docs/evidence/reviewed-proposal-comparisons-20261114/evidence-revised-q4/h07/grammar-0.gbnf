root ::= approved-0
ws ::= [ \t\n\r]*
tool ::= "{" ws "\"type\"" ws ":" ws "\"tool\"" ws "," ws "\"name\"" ws ":" ws tool-body ws "}"
tool-body ::= "\"get_app_info\"" ws "," ws "\"arguments\"" ws ":" ws empty | "\"list_models\"" ws "," ws "\"arguments\"" ws ":" ws empty | "\"search_conversations\"" ws "," ws "\"arguments\"" ws ":" ws search | "\"search_memory\"" ws "," ws "\"arguments\"" ws ":" ws search | "\"calculate\"" ws "," ws "\"arguments\"" ws ":" ws calculate-arguments
empty ::= "{" ws "}"
search ::= "{" ws "\"query\"" ws ":" ws string ws "," ws "\"limit\"" ws ":" ws limit ws "}"
limit ::= "10" | [1-9]
answer ::= "{" ws "\"type\"" ws ":" ws "\"answer\"" ws "," ws "\"text\"" ws ":" ws string ws "}"
string ::= "\"" char* "\""
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
read-result ::= "{" ws "\"type\"" ws ":" ws "\"tool\"" ws "," ws "\"name\"" ws ":" ws "\"read_result\"" ws "," ws "\"arguments\"" ws ":" ws "{" ws "\"step\"" ws ":" ws [1-6] ws "," ws "\"offset\"" ws ":" ws offset ws "}" ws "}"
offset ::= "0" | [1-9] [0-9]? [0-9]? | [1-3] [0-9] [0-9] [0-9] | "40" [0-8] [0-9] | "409" [0-6]
calculate-arguments ::= "{" ws "\"expression\"" ws ":" ws string ws "}"
conversation-read ::= "{" ws "\"id\"" ws ":" ws string ws "," ws "\"messageIndex\"" ws ":" ws message-index ws "," ws "\"offset\"" ws ":" ws message-offset ws "}"
message-index ::= "0" | [1-9] [0-9]? [0-9]? [0-9]?
message-offset ::= "0" | [1-9] [0-9]? [0-9]? [0-9]? [0-9]? [0-9]? | "1000000"

approved-0 ::= "{\"arguments\":{\"limit\":10,\"query\":\"Saffron transit note\"},\"name\":\"search_conversations\",\"type\":\"tool\"}"