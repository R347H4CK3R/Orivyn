<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Orivyn</string>
	<key>OrivynFeedbackRepositoryURL</key>
	<string>https://github.com/R347H4CK3R/Orivyn</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.1</string>
	<key>CFBundleVersion</key>
	<string>5</string>
	<key>CFBundleURLTypes</key>
	<array><dict>
		<key>CFBundleURLName</key><string>app.jarvisevo.ios.compose</string>
		<key>CFBundleURLSchemes</key><array><string>orivyn</string></array>
		<key>CFBundleTypeRole</key><string>Editor</string>
	</dict></array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Orivyn uses the microphone only when you start dictation or a voice conversation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Orivyn transcribes your speech on this iPhone when you start dictation or voice conversation.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Only when you tap Get current location, Orivyn asks iOS for a one-time location displayed on this screen. It is not sent to a model or server.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to attach and recognize its text on this iPhone.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array><dict>
				<key>UISceneConfigurationName</key><string>Orivyn Desk</string>
				<key>UISceneClassName</key><string>UIWindowScene</string>
				<key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).ExternalWorkspaceSceneDelegate</string>
			</dict></array>
		</dict>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
